# Environnement (development | test | production)
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Sécurité des sessions (Obligatoire en production : minimum 32 caractères aléatoires)
SESSION_SECRET=change_me_in_production_with_at_least_32_random_chars_987654321

# Base de données SQLite
DB_PATH=./data/colorfit.db

# Validation DNS MX des emails (true | false)
ENABLE_DNS_MX_CHECK=false

# Configuration Stripe (Laisser vide si non configuré ; l'application indiquera honnêtement l'état)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_SINGLE_ANALYSIS=

# Conservation des données RGPD (en jours)
RETENTION_UNVERIFIED_ACCOUNTS_DAYS=7
RETENTION_INACTIVE_ANALYSES_DAYS=365
